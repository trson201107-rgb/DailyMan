@model List<CartLineVm>
@{ ViewData["Title"] = "Giỏ hàng"; var tong = Model.Sum(l => l.ThanhTien); }
<h1 class="mt">Giỏ hàng</h1>
@if (Model.Count == 0)
{ <div class="empty"><h3>Giỏ hàng đang trống</h3><a class="btn" asp-controller="Shop" asp-action="Index">Tiếp tục mua sắm</a></div> }
else
{
    @if (Model.Any(l => l.GiaDoi))
    {
        <div class="panel warn"><b>Một số sản phẩm đã đổi giá</b> kể từ lúc bạn thêm vào giỏ.
            <form asp-action="AcceptPrices" method="post" style="display:inline"><button class="btn sm camel" type="submit">Đồng ý giá mới</button></form></div>
    }
    <form asp-controller="Order" asp-action="Checkout" method="post" id="cart-form">
        <div class="cols">
            <div>
                <label class="selall"><input type="checkbox" id="sel-all" checked> Chọn tất cả (@Model.Count sản phẩm)</label>
                <div class="scroll"><table>
                    <thead><tr><th></th><th>Sản phẩm</th><th>Đơn giá</th><th>Số lượng</th><th>Thành tiền</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var l in Model)
                    {
                        var hetHang = l.Ton < 1 || l.TrangThaiSP != Const.SP_BAN;
                        <tr>
                            <td><input type="checkbox" name="selected" value="@l.MaBT" class="sel" @(hetHang ? "disabled" : "checked")></td>
                            <td><div class="cell"><div class="tbl-thumb">@await Html.PartialAsync("_Thumb", (l.Anh, l.TenSP))</div>
                                <div><a asp-controller="Shop" asp-action="Details" asp-route-id="@l.MaSP"><b>@l.TenSP</b></a><br><span class="muted small">@l.Mau · @l.Size</span>
                                @if (hetHang) { <br><span class="badge out">Hết hàng / ngừng bán</span> }
                                else if (l.SoLuong > l.Ton) { <br><span class="badge low">Chỉ còn @l.Ton</span> }</div></div></td>
                            <td>@Fmt.Money(l.GiaBan)@if (l.GiaDoi) { <div class="cart-price-alert">Giá cũ @Fmt.Money(l.GiaLucThem)</div> }</td>
                            <td><div class="inline-form"><input form="upd-@l.MaBT" type="number" name="soLuong" value="@l.SoLuong" min="0" max="@Math.Max(l.Ton, 1)" style="width:70px"><button form="upd-@l.MaBT" class="btn sm ghost" type="submit">Cập nhật</button></div></td>
                            <td><b>@Fmt.Money(l.ThanhTien)</b></td>
                            <td><button form="del-@l.MaBT" class="btn sm ghost" type="submit">Xóa</button></td>
                        </tr>
                    }
                    </tbody>
                </table></div>
            </div>
            <aside class="card">
                <h3>Tạm tính</h3>
                <div class="sum-row"><span>Tiền hàng (đã chọn)</span><b id="sel-total">@Fmt.Money(tong)</b></div>
                <p class="muted small">Phí vận chuyển, ưu đãi hạng thành viên và mã giảm giá được tính ở bước thanh toán.</p>
                <button class="btn camel block" type="submit">Tiến hành thanh toán</button>
            </aside>
        </div>
    </form>
    @foreach (var l in Model)
    {
        <form id="upd-@l.MaBT" asp-action="Update" method="post"><input type="hidden" name="maBT" value="@l.MaBT"></form>
        <form id="del-@l.MaBT" asp-action="Remove" method="post"><input type="hidden" name="maBT" value="@l.MaBT"></form>
    }
}
