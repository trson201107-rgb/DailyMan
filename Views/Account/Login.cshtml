@model LoginVm
@{ ViewData["Title"] = "Đăng nhập"; }
<div class="auth card">
    <h1>Đăng nhập</h1>
    <form asp-action="Login" method="post" data-once>
        <div asp-validation-summary="ModelOnly" class="errors"></div>
        <input type="hidden" asp-for="ReturnUrl">
        <label asp-for="TaiKhoan">Email hoặc số điện thoại</label><input asp-for="TaiKhoan" autocomplete="username"><span asp-validation-for="TaiKhoan" class="field-err"></span>
        <label asp-for="MatKhau">Mật khẩu</label>
        <div class="pw"><input asp-for="MatKhau" type="password" autocomplete="current-password"><button type="button" data-toggle-pw>Hiện</button></div><span asp-validation-for="MatKhau" class="field-err"></span>
        <label class="check"><input type="checkbox" asp-for="GhiNho"> Ghi nhớ đăng nhập 30 ngày</label>
        <button class="btn block" type="submit">Đăng nhập</button>
    </form>
    <p class="center muted small mt">Chưa có tài khoản? <a asp-action="Register">Đăng ký</a></p>
</div>
