@model List<DiaChi>
@{ ViewData["Title"] = "Sổ địa chỉ"; }
<div class="row mt"><h1>Sổ địa chỉ</h1><span class="spacer"></span><a class="btn" asp-action="AddressForm">+ Thêm địa chỉ</a></div>
@if (Model.Count == 0) { <div class="empty">Bạn chưa có địa chỉ nào.</div> }
<div class="addr-grid">
@foreach (var d in Model)
{
    <div class="addr @(d.MacDinh ? "sel" : "")">
        <b>@d.TenNguoiNhan</b> · @d.SDT<span class="muted small">@d.DayDu</span>@if (d.MacDinh) { <span class="badge ok" style="align-self:start">Mặc định</span> }
        <div class="acts">
            <a class="btn sm ghost" asp-action="AddressForm" asp-route-id="@d.MaDC">Sửa</a>
            @if (!d.MacDinh) { <form asp-action="DefaultAddress" asp-route-id="@d.MaDC" method="post"><button class="btn sm ghost">Đặt mặc định</button></form> }
            <form asp-action="DeleteAddress" asp-route-id="@d.MaDC" method="post" data-confirm="Xóa địa chỉ này?"><button class="btn sm ghost">Xóa</button></form>
        </div>
    </div>
}
</div>
