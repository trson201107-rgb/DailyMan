@model ProfileVm
@{ ViewData["Title"] = "Hồ sơ của tôi"; var tk = (TaiKhoan)ViewBag.Tk; }
<h1 class="mt">Hồ sơ của tôi</h1>
<div class="grid2">
    <div class="card">
        <h3>Thông tin cá nhân</h3>
        <p class="muted small">Email: @tk.Email @if (tk.HangThanhVien != null) { <span class="badge ok">Hạng @tk.HangThanhVien.TenHang · ưu đãi @tk.HangThanhVien.PhanTramUuDai%</span> }</p>
        <form asp-action="Profile" method="post">
            <div asp-validation-summary="ModelOnly" class="errors"></div>
            <label asp-for="HoTen">Họ và tên</label><input asp-for="HoTen"><span asp-validation-for="HoTen" class="field-err"></span>
            <label asp-for="SoDienThoai">Số điện thoại</label><input asp-for="SoDienThoai"><span asp-validation-for="SoDienThoai" class="field-err"></span>
            <button class="btn mt" type="submit">Lưu thay đổi</button>
        </form>
        <p class="mt"><a asp-action="Addresses">Quản lý sổ địa chỉ →</a></p>
    </div>
    <div class="card">
        <h3>Đổi mật khẩu</h3>
        <form asp-action="ChangePassword" method="post">
            <label>Mật khẩu hiện tại</label><input name="MatKhauCu" type="password" required>
            <label>Mật khẩu mới</label><input name="MatKhauMoi" type="password" minlength="6" required>
            <label>Nhập lại mật khẩu mới</label><input name="NhapLai" type="password" minlength="6" required>
            <button class="btn mt" type="submit">Đổi mật khẩu</button>
        </form>
    </div>
</div>
