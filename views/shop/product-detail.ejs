<%- include('../partials/head') %>
<%
  var gallery = [];
  if (p.AnhDaiDien) gallery.push(p.AnhDaiDien);
  images.forEach(function (im) { gallery.push('/anh/' + im.MaAnh); });
%>
<p class="muted small mt"><a href="/">Trang chủ</a> / <a href="/san-pham?dm=<%= p.MaDM %>"><%= p.TenDM %></a> / <%= p.TenSP %></p>
<div class="detail">
  <div class="gallery" id="gallery">
    <div class="big" title="Bấm để phóng to">
      <% if (gallery.length) { %><img src="<%= gallery[0] %>" alt="<%= p.TenSP %>"><% } else { %><%- include('../partials/thumb', { p: p }) %><% } %>
    </div>
    <% if (gallery.length > 1) { %>
    <div class="thumbs">
      <% gallery.forEach(function (g, i) { %><button type="button" class="<%= i === 0 ? 'on' : '' %>" data-src="<%= g %>" aria-label="Ảnh <%= i + 1 %>"><img src="<%= g %>" alt="" loading="lazy"></button><% }) %>
    </div>
    <% } %>
  </div>
  <div class="lightbox" id="lightbox" role="dialog" aria-label="Xem ảnh lớn"><button type="button" aria-label="Đóng">✕</button><img src="" alt="<%= p.TenSP %>"></div>
  <div>
    <div class="row">
      <% if (p.TongTon < 1) { %><span class="badge out">Hết hàng</span><% } else { %><span class="badge ok">Còn hàng</span><% } %>
      <% if (p.PhanTramGiam > 0) { %><span class="badge sale">Giảm <%= p.PhanTramGiam %>%</span><% } %>
      <% if (p.LaHot) { %><span class="badge hot">Hot</span><% } %><% if (p.LaMoi) { %><span class="badge new">Mới</span><% } %>
    </div>
    <h1 style="margin-top:10px"><%= p.TenSP %></h1>
    <div class="stars"><%= '★'.repeat(Math.round(avg)) + '☆'.repeat(5 - Math.round(avg)) %> <span class="muted small"><%= reviews.length ? avg.toFixed(1) + ' (' + reviews.length + ' đánh giá)' : 'Chưa có đánh giá' %></span></div>
    <div class="price-big"><%= h.money(p.GiaBan) %><% if (p.PhanTramGiam > 0) { %><span class="old-price"><%= h.money(p.GiaGoc) %></span><% } %></div>
    <p><%= p.MoTa %></p>

    <form id="add-form" method="post" action="/gio-hang/them" data-once>
      <input type="hidden" name="maSP" value="<%= p.MaSP %>">
      <label>Màu sắc</label>
      <div class="opt">
        <% colors.forEach(function (c) { var any = variants.some(function (v) { return v.MaMau === c.MaMau && v.SoLuongTon > 0; }); %>
          <label><input type="radio" name="maMau" value="<%= c.MaMau %>" <%= any ? '' : 'disabled' %> required><span class="swatch"><i class="dot" style="background:<%= c.MaHex || '#ddd' %>"></i><%= c.TenMau %></span></label>
        <% }) %>
      </div>
      <label>Size</label>
      <div class="opt">
        <% sizes.forEach(function (s) { %><label><input type="radio" name="maSize" value="<%= s.MaSize %>" required><span class="chip"><%= s.TenSize %></span></label><% }) %>
      </div>
      <p class="muted small" id="stock-info">Chọn đủ màu và size để xem tồn kho</p>
      <label>Số lượng</label>
      <div class="qty"><button type="button" data-d="-1">−</button><input type="number" name="soLuong" value="1" min="1" max="99"><button type="button" data-d="1">+</button></div>
      <div class="row mt">
        <button class="btn camel" type="submit" <%= p.TongTon < 1 ? 'disabled' : '' %>>Thêm vào giỏ hàng</button>
        <button class="btn" type="submit" name="mua" value="1" <%= p.TongTon < 1 ? 'disabled' : '' %>>Mua ngay</button>
      </div>
    </form>
    <script id="variants-json" type="application/json"><%- variantsJson %></script>
    <div class="policy">🚚 Miễn phí vận chuyển đơn từ <%= h.money(1000000) %> · 🔁 Đổi trả trong 7 ngày · 💳 Thanh toán COD hoặc chuyển khoản QR</div>
  </div>
</div>

<h2 id="danh-gia">Đánh giá của khách hàng</h2>
<% if (!user) { %>
  <div class="panel"><a href="/dang-nhap"><u>Đăng nhập</u></a> để đánh giá sản phẩm này (chỉ khách đã mua và nhận hàng mới đánh giá được).</div>
<% } else if (canReview) { %>
  <form method="post" action="/san-pham/<%= p.MaSP %>/danh-gia" class="panel">
    <strong><%= myReview ? 'Đánh giá của bạn (sửa lại)' : 'Gửi đánh giá của bạn' %></strong>
    <div class="opt" style="margin:8px 0">
      <% [1,2,3,4,5].forEach(function (n) { %><label><input type="radio" name="soSao" value="<%= n %>" <%= myReview && myReview.SoSao === n ? 'checked' : '' %> required><span class="chip"><%= n %> ★</span></label><% }) %>
    </div>
    <textarea name="noiDung" rows="3" maxlength="500" placeholder="Chia sẻ cảm nhận về chất liệu, form dáng, size..."><%= myReview ? myReview.NoiDung : '' %></textarea>
    <button class="btn sm mt" type="submit">Gửi đánh giá</button>
  </form>
<% } else { %>
  <div class="panel">Bạn cần mua và nhận hàng (đơn <strong>Hoàn thành</strong>) mới đánh giá được sản phẩm này.</div>
<% } %>
<% if (!reviews.length) { %><p class="muted mt">Chưa có đánh giá nào.</p><% } else { %>
  <div class="card mt"><% reviews.forEach(function (r) { %>
    <div style="margin-bottom:12px"><strong><%= r.HoTen %></strong> <span class="stars"><%= '★'.repeat(r.SoSao) %></span> <span class="muted small"><%= h.fmtDate(r.NgayDG, false) %></span><br><%= r.NoiDung %></div>
  <% }) %></div>
<% } %>

<% if (related.length) { %>
<div class="section-title"><h2>Sản phẩm liên quan</h2></div>
<div class="grid"><% related.forEach(function (x) { %><%- include('../partials/product-card', { p: x }) %><% }) %></div>
<% } %>
<%- include('../partials/foot') %>
