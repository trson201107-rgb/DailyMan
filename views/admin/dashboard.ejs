<%- include('../partials/admin-head') %>
<h1>Tổng quan</h1>
<form method="get" class="range-form">
  <div><label>Kỳ báo cáo</label>
    <div class="row" style="gap:6px">
      <a class="chip-link <%= range.ky === '7' ? 'on' : '' %>" href="/admin?ky=7">7 ngày</a>
      <a class="chip-link <%= range.ky === '30' ? 'on' : '' %>" href="/admin?ky=30">30 ngày</a>
      <a class="chip-link <%= range.ky === 'thang' ? 'on' : '' %>" href="/admin?ky=thang">Tháng này</a>
    </div></div>
  <div><label>Từ ngày</label><input type="date" name="tu" value="<%= range.tu %>"></div>
  <div><label>Đến ngày</label><input type="date" name="den" value="<%= range.den %>"></div>
  <button class="btn">Xem báo cáo</button>
</form>
<p class="muted small" style="margin-top:-6px">Kỳ đang xem: <strong><%= range.tu.split('-').reverse().join('/') %></strong> đến <strong><%= range.den.split('-').reverse().join('/') %></strong>. Doanh thu chỉ tính đơn đã Hoàn thành.<% if (range.note) { %> <em><%= range.note %></em><% } %></p>
<div class="stats">
  <div class="stat"><div class="v"><%= h.money(sum.doanhThu) %></div><div class="l">Doanh thu trong kỳ</div></div>
  <div class="stat"><div class="v"><%= sum.donHang %></div><div class="l">Đơn hàng trong kỳ (không tính hủy, đổi trả)</div></div>
  <div class="stat"><div class="v"><%= sum.khachMoi %></div><div class="l">Khách hàng mới trong kỳ</div></div>
  <div class="stat"><div class="v"><a href="/admin/don-hang?tt=1"><%= sum.choXuLy %></a></div><div class="l">Đơn chờ xác nhận (hiện tại)</div></div>
  <div class="stat"><div class="v"><a href="/admin/doi-tra?tt=Ch%E1%BB%9D+x%E1%BB%AD+l%C3%BD"><%= sum.doiTraCho %></a></div><div class="l">Yêu cầu đổi trả chờ xử lý</div></div>
  <div class="stat"><div class="v"><a href="/admin/san-pham?trangThai=sap-het"><%= sum.sapHet %></a></div><div class="l">Sản phẩm sắp hết hàng</div></div>
  <div class="stat"><div class="v"><a href="/admin/san-pham?trangThai=het-hang"><%= sum.hetHang %></a></div><div class="l">Sản phẩm hết hàng</div></div>
</div>
<% if (empty) { %><div class="panel warn" style="margin-top:0"><strong>Không có đơn hàng nào trong kỳ này.</strong> Hãy chọn kỳ khác để xem số liệu.</div><% } %>
<div class="grid2">
  <div class="card"><h3>Doanh thu theo ngày</h3>
    <div class="bars wide"><% rev.forEach(function (r) { var d = new Date(r.Ngay).toISOString(); %><div class="bar" title="<%= d.slice(8,10) %>/<%= d.slice(5,7) %>: <%= h.money(r.DoanhThu) %>"><i style="height:<%= Math.round(Number(r.DoanhThu) / max * 140) %>px"></i><span><%= d.slice(8, 10) + '/' + d.slice(5, 7) %></span></div><% }) %></div></div>
  <div class="card"><h3>Bán chạy nhất trong kỳ</h3>
    <% if (!best.length) { %><p class="muted">Chưa có dữ liệu.</p><% } %>
    <ol style="margin:0;padding-left:20px"><% best.forEach(function (b) { %><li><a href="/admin/san-pham/<%= b.MaSP %>"><%= b.TenSP %></a> — <strong><%= b.DaBan %></strong> đã bán</li><% }) %></ol>
    <h3 class="mt">Biến thể sắp hết (≤ 3)</h3>
    <% low.forEach(function (v) { %><div class="small"><a href="/admin/san-pham/<%= v.MaSP %>"><%= v.TenSP %></a> · <%= v.SKU %> · <span class="badge <%= v.SoLuongTon === 0 ? 'out' : 'low' %>">còn <%= v.SoLuongTon %></span></div><% }) %>
  </div>
</div>
<h3 class="mt">Đơn hàng gần đây trong kỳ</h3>
<div class="scroll"><table><thead><tr><th>Mã</th><th>Khách</th><th>Thời gian</th><th>Giá trị</th><th>Trạng thái</th></tr></thead><tbody>
  <% if (!recent.length) { %><tr><td colspan="5" class="muted">Không có đơn hàng trong kỳ.</td></tr><% } %>
  <% recent.forEach(function (o) { %><tr><td><a href="/admin/don-hang/<%= o.MaDH %>">#<%= o.MaDH %></a></td><td><%= o.TenNguoiNhan %></td><td><%= h.fmtDate(o.NgayDat) %></td><td><%= h.money(o.TongThanhToan) %></td><td><span class="badge st-<%= o.MaTrangThai %>"><%= o.TenTrangThai %></span></td></tr><% }) %>
</tbody></table></div>
<%- include('../partials/admin-foot') %>
