<%- include('../partials/admin-head') %>
<div class="row mb"><h1 style="margin:0">Quản lý sản phẩm</h1><span class="spacer"></span>
  <% if (user.role === 'Admin') { %><a class="btn camel" href="/admin/san-pham/them">+ Thêm sản phẩm</a><% } %></div>
<div class="stats">
  <div class="stat"><div class="v"><%= counts.Tong %></div><div class="l">Tổng sản phẩm</div></div>
  <div class="stat"><div class="v"><%= counts.DangBan || 0 %></div><div class="l">Đang bán</div></div>
  <div class="stat"><div class="v"><%= counts.SapHet || 0 %></div><div class="l">Sắp hết hàng</div></div>
  <div class="stat"><div class="v"><%= counts.HetHang || 0 %></div><div class="l">Hết hàng</div></div>
</div>
<form method="get" class="toolbar">
  <div><label>Tìm (tên / SKU)</label><input name="q" value="<%= f.q %>" placeholder="Tên, danh mục hoặc SKU"></div>
  <div><label>Danh mục</label><select name="dm"><option value="">Tất cả</option><% categories.forEach(function (c) { %><option value="<%= c.MaDM %>" <%= f.dm === c.MaDM ? 'selected' : '' %>><%= c.TenDM %></option><% }) %></select></div>
  <div><label>Trạng thái</label><select name="trangThai"><% [['','Tất cả'],['dang-ban','Đang bán'],['an','Đang ẩn'],['sap-het','Sắp hết hàng'],['het-hang','Hết hàng']].forEach(function (o) { %><option value="<%= o[0] %>" <%= f.trangThai === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select></div>
  <div><label>Sắp xếp</label><select name="sort"><% [['cap-nhat','Mới cập nhật'],['moi','Mới tạo'],['ten','Tên A → Z'],['gia-tang','Giá tăng'],['gia-giam','Giá giảm'],['dm','Danh mục'],['ton-tang','Tồn kho thấp'],['hot','Lượt xem']].forEach(function (o) { %><option value="<%= o[0] %>" <%= f.sort === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %></select></div>
  <button class="btn">Lọc</button><a class="btn ghost" href="/admin/san-pham">Xóa lọc</a>
</form>
<% if (!items.length) { %><div class="empty">Không có sản phẩm nào phù hợp.</div><% } else { %>
<div class="scroll"><table>
  <thead><tr><th>Sản phẩm</th><th>Danh mục</th><th>Giá bán</th><th>Tồn</th><th>Trạng thái</th><th>Cập nhật</th><th></th></tr></thead>
  <tbody><% items.forEach(function (p) { %>
    <tr>
      <td><div class="cell"><div class="tbl-thumb"><%- include('../partials/thumb', { p: p }) %></div><div><a href="/admin/san-pham/<%= p.MaSP %>"><strong><%= p.TenSP %></strong></a><br><span class="muted small">#<%= p.MaSP %> · <%= p.SoBienThe %> biến thể · <%= p.LuotXem %> lượt xem</span></div></div></td>
      <td><%= p.TenDM %></td><td><%= h.money(p.GiaBan) %></td>
      <td><strong><%= p.TongTon %></strong> <% if (p.TongTon === 0) { %><span class="badge out">Hết hàng</span><% } else if (p.TongTon <= 10) { %><span class="badge low">Sắp hết</span><% } %></td>
      <td><% if (p.TrangThai === 'Đang bán') { %><span class="badge ok">Đang bán</span><% } else { %><span class="badge hidden">Đã ẩn</span><% } %></td>
      <td class="small muted"><%= h.fmtDate(p.NgayCapNhat || p.NgayTao) %></td>
      <td><div class="actions">
        <a class="btn sm ghost" href="/admin/san-pham/<%= p.MaSP %>">Xem</a>
        <% if (user.role === 'Admin') { %>
          <a class="btn sm ghost" href="/admin/san-pham/<%= p.MaSP %>/sua">Sửa</a>
          <% if (p.TrangThai === 'Đang bán') { %>
            <form method="post" action="/admin/san-pham/<%= p.MaSP %>/an" data-confirm="Ẩn sản phẩm này? Khách sẽ không còn thấy nó."><button class="btn sm ghost">Ẩn</button></form>
          <% } else { %>
            <form method="post" action="/admin/san-pham/<%= p.MaSP %>/hien"><button class="btn sm ghost">Hiện lại</button></form>
            <form method="post" action="/admin/san-pham/<%= p.MaSP %>/xoa" data-confirm="XÓA VĨNH VIỄN sản phẩm này? Không thể khôi phục."><button class="btn sm danger">Xóa hẳn</button></form>
          <% } %>
        <% } %></div></td>
    </tr><% }) %></tbody></table></div>
<p class="muted small">Hiển thị <%= items.length %> / <%= meta.total %> sản phẩm.</p>
<%- include('../partials/pagination') %>
<% } %>
<%- include('../partials/admin-foot') %>
