@model DonHang
@{ ViewData["Title"] = "Đơn #" + Model.MaDH; var coTheHuy = Model.MaTrangThai is Const.CHO or Const.XAC_NHAN or Const.DONG_GOI; }
<div class="row"><h1>Đơn hàng #@Model.MaDH <span class="badge st-@Model.MaTrangThai">@Model.TrangThai?.TenTrangThai</span></h1><span class="spacer"></span><a class="btn ghost" asp-action="Index">← Danh sách</a></div>
<div class="cols">
    <div>
        <div class="scroll"><table>
            <thead><tr><th>Sản phẩm</th><th>Đơn giá</th><th>SL</th><th>Thành tiền</th></tr></thead>
            <tbody>@foreach (var c in Model.ChiTiets)
            { <tr><td><b>@c.BienThe?.SanPham?.TenSP</b><br><span class="muted small">@c.BienThe?.MauSac?.TenMau · @c.BienThe?.KichCo?.TenSize · @c.BienThe?.SKU</span></td><td>@Fmt.Money(c.DonGia)</td><td>@c.SoLuong</td><td>@Fmt.Money(c.SoLuong * c.DonGia)</td></tr> }</tbody></table></div>
        <h3 class="mt">Lịch sử xử lý</h3>
        <ul class="timeline">@foreach (var l in Model.LichSus.OrderBy(x => x.ThoiGian)) { <li><b>@l.TrangThai?.TenTrangThai</b> <span class="muted small">@Fmt.DateTime(l.ThoiGian) · @(l.NguoiDoi?.HoTen ?? "Hệ thống / khách")</span>@if (!string.IsNullOrEmpty(l.GhiChu)) { <br><span class="small">@l.GhiChu</span> }</li> }</ul>
    </div>
    <aside>
        <div class="card mb"><h3>Khách hàng</h3><b>@Model.TenNguoiNhan</b> · @Model.SDTNguoiNhan<br><span class="muted">@Model.DiaChiGiao</span><br><span class="small muted">Tài khoản: <a asp-controller="Accounts" asp-action="CustomerDetail" asp-route-id="@Model.MaTK">@Model.TaiKhoan?.HoTen</a></span>@if (!string.IsNullOrEmpty(Model.GhiChu)) { <p class="small">Ghi chú: @Model.GhiChu</p> }</div>
        <div class="card mb"><h3>Thanh toán</h3>
            <div class="sum-row"><span>Tiền hàng</span><span>@Fmt.Money(Model.TienHang)</span></div>
            <div class="sum-row"><span>Phí vận chuyển</span><span>@Fmt.Money(Model.PhiVanChuyen)</span></div>
            @if (Model.UuDaiHang > 0) { <div class="sum-row"><span>Ưu đãi hạng</span><span>−@Fmt.Money(Model.UuDaiHang)</span></div> }
            @if (Model.TienGiam - Model.UuDaiHang > 0) { <div class="sum-row"><span>Mã @Model.Voucher?.MaCode</span><span>−@Fmt.Money(Model.TienGiam - Model.UuDaiHang)</span></div> }
            <div class="sum-row total"><span>Tổng</span><span>@Fmt.Money(Model.ThanhToan?.SoTien ?? 0)</span></div>
            <p class="muted small">@Model.ThanhToan?.PhuongThuc?.TenPT · @Model.ThanhToan?.TrangThaiTT</p></div>
        @if (Model.MaTrangThai == Const.HUY) { <div class="panel bad"><b>Đơn đã hủy</b><br>Lý do: @Model.LyDoHuy</div> }
        @if (Model.MaTrangThai < Const.HOAN_THANH)
        { <form asp-action="Advance" asp-route-id="@Model.MaDH" method="post" class="mb"><button class="btn camel block">Chuyển sang: @Const.TEN_TRANG_THAI[Model.MaTrangThai + 1]</button></form> }
        @if (coTheHuy)
        {
            <div class="card"><h3>Hủy đơn</h3>
                <form asp-action="Cancel" asp-route-id="@Model.MaDH" method="post" data-confirm="Hủy đơn này và hoàn lại tồn kho?">
                    <label>Lý do hủy</label><select name="lyDo" required><option value="">-- Chọn lý do --</option>@foreach (var r in Const.LY_DO_HUY) { <option>@r</option> }</select>
                    <label>Chi tiết</label><input name="ghiChu" maxlength="200">
                    <button class="btn danger mt">Hủy đơn</button></form></div>
        }
    </aside>
</div>
