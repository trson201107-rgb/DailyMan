# Sao chép file này thành .env rồi điền thông tin (KHÔNG commit file .env lên git)
PORT=3000
NODE_ENV=development
SESSION_SECRET=doi-chuoi-bi-mat-nay

# --- SQL Server ---
DB_SERVER=localhost
DB_PORT=1433
# Nếu dùng named instance (vd SQLEXPRESS05) mà KHÔNG đặt cổng tĩnh: bỏ DB_PORT và dùng dòng dưới (cần bật SQL Server Browser)
# DB_INSTANCE=SQLEXPRESS05
DB_NAME=ThoiTrangNam
DB_USER=sa
DB_PASSWORD=MatKhauCuaBan
# Chạy local: DB_ENCRYPT=false, DB_TRUST_CERT=true  |  Azure SQL: DB_ENCRYPT=true, DB_TRUST_CERT=false
DB_ENCRYPT=false
DB_TRUST_CERT=true

# Múi giờ hiển thị ngày giờ: DB đặt ở máy VN -> UTC | DB đặt trên cloud (giờ UTC) -> Asia/Ho_Chi_Minh
DISPLAY_TZ=UTC
