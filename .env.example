# Sao chép file này thành .env rồi điền thông tin (KHÔNG commit file .env lên git)
PORT=3000
NODE_ENV=development
SESSION_SECRET=doi-chuoi-bi-mat-nay

# --- SQL Server ---
DB_SERVER=localhost
DB_PORT=1433
# Nếu dùng named instance (vd SQLEXPRESS05) mà KHÔNG đặt cổng tĩnh: bỏ DB_PORT và dùng dòng dưới (cần bật SQL Server Browser)
# DB_INSTANCE=SQLEXPRESS05
DB_NAME=ThoiTrangNam
DB_USER=sa
DB_PASSWORD=MatKhauCuaBan
# Chạy local: DB_ENCRYPT=false, DB_TRUST_CERT=true  |  Azure SQL: DB_ENCRYPT=true, DB_TRUST_CERT=false
DB_ENCRYPT=false
DB_TRUST_CERT=true

# Múi giờ hiển thị ngày giờ: DB đặt ở máy VN -> UTC | DB đặt trên cloud (giờ UTC) -> Asia/Ho_Chi_Minh
DISPLAY_TZ=UTC

# --- Địa chỉ website (dùng trong liên kết email quên mật khẩu). Chạy local có thể bỏ trống ---
APP_URL=http://localhost:3000

# --- Gửi email cho chức năng "Quên mật khẩu" (SMTP). Bỏ dấu # và điền thông tin để bật gửi email thật ---
# Ví dụ Gmail: bật xác minh 2 bước rồi tạo "Mật khẩu ứng dụng" (App password), dùng mật khẩu đó cho SMTP_PASS
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tai-khoan-cua-ban@gmail.com
# SMTP_PASS=mat-khau-ung-dung
# MAIL_FROM=dailyman <tai-khoan-cua-ban@gmail.com>

# Chỉ để DEMO khi CHƯA có SMTP: hiện liên kết đặt lại mật khẩu ngay trên trang (KHÔNG bật khi chạy thật vì ai cũng đặt lại được mật khẩu người khác)
RESET_SHOW_LINK=false
