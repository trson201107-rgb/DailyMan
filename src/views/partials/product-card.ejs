<article class="pcard <%= p.TongTon < 1 ? 'soldout' : '' %>">
  <div class="tags">
    <% if (p.LaHot) { %><span class="badge hot">Hot</span><% } %><% if (p.LaMoi) { %><span class="badge new">Mới</span><% } %>
    <% if (p.TongTon < 1) { %><span class="badge out">Hết hàng</span><% } %>
  </div>
  <a class="thumb" href="/san-pham/<%= p.MaSP %>"><%- include('thumb', { p: p }) %></a>
  <div class="info">
    <span class="muted small"><%= p.TenDM %></span>
    <a class="name" href="/san-pham/<%= p.MaSP %>"><%= p.TenSP %></a>
    <span class="price"><%= h.money(p.GiaBan) %></span>
  </div>
</article>
