<%- include('../partials/head') %>
<h1 class="mt">Giỏ hàng <span class="muted small">(<%= lines.length %> sản phẩm)</span></h1>
<% if (!lines.length) { %>
  <div class="empty"><h3>Giỏ hàng của bạn đang trống</h3><a class="btn" href="/san-pham">Tiếp tục mua sắm</a></div>
<% } else { %>
<% if (!user) { %><div class="flash info">Bạn đang dùng giỏ hàng tạm. <a href="/dang-nhap"><u>Đăng nhập</u></a> để đặt hàng và dùng mã giảm giá — giỏ hàng sẽ được giữ nguyên.</div><% } %>
<div class="cols">
  <div class="scroll"><table>
    <thead><tr><th>Sản phẩm</th><th>Đơn giá</th><th>Số lượng</th><th>Thành tiền</th><th></th></tr></thead>
    <tbody>
    <% lines.forEach(function (l) { %>
      <tr>
        <td><div class="cell"><div class="tbl-thumb"><%- include('../partials/thumb', { p: l }) %></div>
          <div><a href="/san-pham/<%= l.MaSP %>"><strong><%= l.TenSP %></strong></a><br><span class="muted small"><%= l.TenMau %> / <%= l.TenSize %> · <%= l.SKU %></span>
          <% if (l.HetHang) { %><br><span class="badge out">Hết hàng / ngừng bán — không tính vào tổng</span><% } else if (l.VuotTon) { %><br><span class="badge low">Chỉ còn <%= l.Ton %> sản phẩm</span><% } %></div></div></td>
        <td><%= h.money(l.GiaBan) %></td>
        <td><form method="post" action="/gio-hang/cap-nhat"><input type="hidden" name="maBT" value="<%= l.MaBT %>">
          <div class="qty" data-submit="1"><button type="button" data-d="-1">−</button><input type="number" name="soLuong" value="<%= l.SoLuong %>" min="1" max="<%= Math.max(l.Ton, 1) %>"><button type="button" data-d="1">+</button></div></form></td>
        <td><strong><%= h.money(l.ThanhTien) %></strong></td>
        <td><form method="post" action="/gio-hang/xoa"><input type="hidden" name="maBT" value="<%= l.MaBT %>"><button class="btn sm ghost" type="submit">Xóa</button></form></td>
      </tr>
    <% }) %>
    </tbody></table>
    <p><a href="/san-pham">← Tiếp tục mua sắm</a></p>
  </div>
  <aside class="card">
    <h3>Mã giảm giá</h3>
    <% if (voucher) { %>
      <div class="row"><span class="badge ok"><%= voucher.MaCode %></span><span class="spacer"></span>
        <form method="post" action="/gio-hang/bo-ma"><button class="btn sm ghost">Bỏ mã</button></form></div>
    <% } else { %>
      <form method="post" action="/gio-hang/ma-giam-gia" class="row" style="flex-wrap:nowrap"><input name="code" placeholder="VD: DAILY10" value="<%= code %>"><button class="btn sm" type="submit">Áp dụng</button></form>
      <% if (wallet.length) { %><p class="small muted" style="margin-bottom:4px">Ví voucher của bạn:</p>
        <div class="chips"><% wallet.forEach(function (v) { %>
          <form method="post" action="/gio-hang/ma-giam-gia" style="display:inline"><input type="hidden" name="code" value="<%= v.MaCode %>"><button class="btn sm ghost" title="Đơn tối thiểu <%= h.money(v.DonToiThieu) %>"><%= v.MaCode %> · <%= v.LoaiGiam === 'PHAN_TRAM' ? '-' + v.GiaTriGiam + '%' : '-' + h.money(v.GiaTriGiam) %></button></form>
        <% }) %></div><% } %>
    <% } %>
    <h3 class="mt">Tóm tắt đơn hàng</h3>
    <div class="sum-row"><span>Tạm tính</span><span><%= h.money(tienHang) %></span></div>
    <div class="sum-row"><span>Giảm giá</span><span>-<%= h.money(giam) %></span></div>
    <div class="sum-row"><span>Phí vận chuyển</span><span><%= phi ? h.money(phi) : 'Miễn phí' %></span></div>
    <div class="sum-row total"><span>Tổng cộng</span><span><%= h.money(tong) %></span></div>
    <a class="btn camel block mt" href="/thanh-toan">Tiến hành thanh toán</a>
  </aside>
</div>
<% } %>
<%- include('../partials/foot') %>
